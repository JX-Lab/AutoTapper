    <string name="config_title">点击配置</string>
    <string name="config_subtitle">一次设定点击节奏，悬浮控制器会立即使用。</string>
    <string name="config_intro">动作序列会依次执行点击和手势。点击保留连点与按压参数，手势保留重复与持续时间；实际等待 = 动作或全局间隔 + 随机延迟。</string>
    <string name="interval_label">基础间隔</string>
    <string name="interval_help">范围：至少 100 ms。数值越小点击越快；300–800 ms 适合多数界面，超过 1000 ms 更稳但更慢。</string>
    <string name="random_extra_label">随机附加延迟</string>
    <string name="random_extra_help">范围：0 或更大。每次额外随机等待 0–该数值 ms；0 为固定节奏，数值越大节奏越不规则。</string>
    <string name="repeat_count_label">点击轮数</string>
    <string name="repeat_count_help">范围：0 或正整数。0 会一直运行到手动停止；1 只执行一轮，数值越大重复轮数越多。</string>
    <string name="controller_alpha_label">悬浮窗透明度</string>
    <string name="controller_alpha_value">%1$.0f%%</string>
    <string name="default_hold_label">默认按压时长</string>
    <string name="default_hold_help">范围：20–10000 ms。40 ms 接近普通点击；约 500 ms 起通常表现为长按，数值越大按住越久。</string>
    <string name="default_point_repeat_label">默认每点连点次数</string>
    <string name="default_point_repeat_help">范围：1–9999。1 表示每轮点一次；数值越大，切换到下一点前连续点击越多。</string>
