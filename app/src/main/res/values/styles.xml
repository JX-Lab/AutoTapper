<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Card.AutoTapper" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/card_bg</item>
        <item name="strokeColor">@color/outline_variant</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Card.AutoTapper.Filled" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/surface_container_high</item>
    </style>

    <style name="Card.AutoTapper.Header" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">28dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@android:color/transparent</item>
    </style>

    <style name="Text.AutoTapper.Eyebrow" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/on_primary_container</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
    </style>

    <style name="Text.AutoTapper.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.AutoTapper.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.AutoTapper.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Text.AutoTapper.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Text.AutoTapper.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Button.AutoTapper.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="iconTint">@color/on_primary</item>
        <item name="android:textAppearance">@style/Text.AutoTapper.Label</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <style name="Button.AutoTapper.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/outline</item>
        <item name="android:textColor">@color/on_primary_container</item>
        <item name="iconTint">@color/on_primary_container</item>
        <item name="android:textAppearance">@style/Text.AutoTapper.Label</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="Button.AutoTapper.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/on_primary_container</item>
        <item name="iconTint">@color/on_primary_container</item>
        <item name="android:textAppearance">@style/Text.AutoTapper.Label</item>
    </style>

    <style name="Input.AutoTapper.Outlined" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/surface_container_high</item>
        <item name="boxStrokeColor">@color/outline</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/text_secondary</item>
        <item name="helperTextTextColor">@color/text_secondary</item>
        <item name="shapeAppearance">@style/ShapeAppearance.AutoTapper.Small</item>
    </style>

</resources>
