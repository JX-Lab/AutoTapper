    <string name="config_title">Tap Configuration</string>
    <string name="config_subtitle">Tune the rhythm once; the floating controller uses it instantly.</string>
    <string name="config_intro">Multi-point mode runs each point in order, including its own tap count and hold duration. Actual wait time = point or global delay + random extra.</string>
    <string name="interval_label">Base interval</string>
    <string name="interval_help">Milliseconds between taps. Try a value from 300 to 800 first.</string>
    <string name="random_extra_label">Random extra delay</string>
    <string name="random_extra_help">Adds a random delay from 0 to this value after each tap. Enter 0 for a fixed rhythm.</string>
    <string name="repeat_count_label">Rounds</string>
    <string name="repeat_count_help">Each round completes every point, including its configured consecutive taps. Enter 0 to continue until stopped.</string>
