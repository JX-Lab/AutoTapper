<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/capture_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_picker"
        style="@style/Card.AutoTapper"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_margin="16dp"
        android:minWidth="@dimen/overlay_min_width"
        app:cardBackgroundColor="@color/surface_container"
        app:cardCornerRadius="22dp"
        app:cardElevation="12dp"
        app:strokeColor="@color/primary"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/overlay_eyebrow"
                android:textAppearance="@style/Text.AutoTapper.Eyebrow" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/overlay_title"
                android:textAppearance="@style/Text.AutoTapper.Headline" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/overlay_hint"
                android:textAppearance="@style/Text.AutoTapper.Body" />

            <TextView
                android:id="@+id/tv_picker_counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_badge"
                android:paddingStart="14dp"
                android:paddingTop="7dp"
                android:paddingEnd="14dp"
                android:paddingBottom="7dp"
                android:textAppearance="@style/Text.AutoTapper.Label"
                android:textColor="@color/on_primary_container" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="end"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_cancel_capture"
                    style="@style/Button.AutoTapper.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="@string/cancel_capture" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_finish_capture"
                    style="@style/Button.AutoTapper.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:minHeight="48dp"
                    android:text="@string/finish_capture" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
