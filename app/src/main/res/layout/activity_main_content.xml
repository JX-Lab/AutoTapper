<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="18dp"
    android:paddingEnd="18dp"
    android:paddingBottom="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_hero_panel"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_autotapper" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/screen_eyebrow" android:textAppearance="@style/Text.AutoTapper.Eyebrow" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/screen_title" android:textAppearance="@style/Text.AutoTapper.Headline" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btn_theme"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circular_button"
                android:contentDescription="@string/theme_button_desc"
                android:padding="9dp"
                android:src="@drawable/ic_theme"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/btn_language"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_circular_button"
                android:contentDescription="@string/language_button_desc"
                android:gravity="center"
                android:text="@string/language_button"
                android:textAppearance="@style/Text.AutoTapper.Caption"
                android:textColor="@color/text_secondary"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btn_tutorial"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_circular_button"
                android:contentDescription="@string/tutorial_button_desc"
                android:padding="9dp"
                android:src="@drawable/ic_help"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/screen_subtitle"
            android:textAppearance="@style/Text.AutoTapper.Body" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView android:id="@+id/tv_version" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textAppearance="@style/Text.AutoTapper.Caption" android:textColor="@color/on_primary_container" android:textStyle="bold" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_check_update" style="@style/Button.AutoTapper.Text" android:layout_width="wrap_content" android:layout_height="40dp" android:minHeight="40dp" android:text="@string/check_update" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_permissions"
        style="@style/Card.AutoTapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/status_title" android:textAppearance="@style/Text.AutoTapper.Title" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/status_subtitle" android:textAppearance="@style/Text.AutoTapper.Caption" />
            <LinearLayout android:id="@+id/row_overlay_permission" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_status_row" android:gravity="center_vertical" android:minHeight="54dp" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="6dp">
                <View android:id="@+id/dot_overlay" android:layout_width="10dp" android:layout_height="10dp" />
                <TextView android:id="@+id/tv_overlay_state" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:textAppearance="@style/Text.AutoTapper.Body" android:textColor="@color/text_primary" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_grant_overlay" style="@style/Button.AutoTapper.Text" android:layout_width="wrap_content" android:layout_height="40dp" android:minHeight="40dp" android:text="@string/grant_permission_button" />
            </LinearLayout>
            <LinearLayout android:id="@+id/row_accessibility_permission" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_status_row" android:gravity="center_vertical" android:minHeight="54dp" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="6dp">
                <View android:id="@+id/dot_accessibility" android:layout_width="10dp" android:layout_height="10dp" />
                <TextView android:id="@+id/tv_accessibility_state" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:textAppearance="@style/Text.AutoTapper.Body" android:textColor="@color/text_primary" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_grant_accessibility" style="@style/Button.AutoTapper.Text" android:layout_width="wrap_content" android:layout_height="40dp" android:minHeight="40dp" android:text="@string/grant_permission_button" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_open_controller"
        style="@style/Button.AutoTapper.Primary"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="@string/open_controller"
        app:icon="@drawable/ic_floating_handle"
        app:iconGravity="textStart"
        app:iconPadding="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_status_row"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/controller_alpha_label" android:textAppearance="@style/Text.AutoTapper.Label" />
            <TextView android:id="@+id/tv_controller_alpha_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_badge" android:gravity="center" android:minWidth="54dp" android:paddingStart="10dp" android:paddingTop="5dp" android:paddingEnd="10dp" android:paddingBottom="5dp" android:textAppearance="@style/Text.AutoTapper.Caption" android:textColor="@color/on_primary_container" android:textStyle="bold" />
        </LinearLayout>
        <com.google.android.material.slider.Slider android:id="@+id/slider_controller_alpha" android:layout_width="match_parent" android:layout_height="wrap_content" android:stepSize="0.05" android:valueFrom="0.3" android:valueTo="1.0" app:haloColor="@color/control_highlight" app:thumbColor="@color/primary" app:trackColorActive="@color/primary" app:trackHeight="4dp" app:trackColorInactive="@color/outline" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        style="@style/Card.AutoTapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="top" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/points_title" android:textAppearance="@style/Text.AutoTapper.Title" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/points_subtitle" android:textAppearance="@style/Text.AutoTapper.Caption" />
                </LinearLayout>
                <TextView android:id="@+id/tv_points_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:background="@drawable/bg_badge" android:paddingStart="11dp" android:paddingTop="5dp" android:paddingEnd="11dp" android:paddingBottom="5dp" android:textAppearance="@style/Text.AutoTapper.Caption" android:textColor="@color/on_primary_container" android:textStyle="bold" />
            </LinearLayout>
            <TextView android:id="@+id/tv_points_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_status_row" android:gravity="center" android:minHeight="72dp" android:padding="16dp" android:text="@string/points_empty" android:textAppearance="@style/Text.AutoTapper.Body" android:visibility="gone" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_points" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:nestedScrollingEnabled="false" android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_status_row"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">
        <TextView android:id="@+id/tv_profile_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textAppearance="@style/Text.AutoTapper.Body" android:textColor="@color/text_primary" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_profile_save" style="@style/Button.AutoTapper.Primary" android:layout_width="wrap_content" android:layout_height="48dp" android:minHeight="48dp" android:text="@string/profile_save" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        style="@style/Card.AutoTapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:id="@+id/btn_toggle_config" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:minHeight="64dp" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="10dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/config_title" android:textAppearance="@style/Text.AutoTapper.Title" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="1" android:ellipsize="end" android:text="@string/config_subtitle" android:textAppearance="@style/Text.AutoTapper.Caption" />
                </LinearLayout>
                <ImageView android:id="@+id/arrow_config" android:layout_width="40dp" android:layout_height="40dp" android:contentDescription="@null" android:padding="8dp" android:src="@drawable/ic_expand_more" app:tint="@color/text_secondary" />
            </LinearLayout>
            <LinearLayout android:id="@+id/group_config_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="16dp" android:visibility="gone">
                <com.google.android.material.textfield.TextInputLayout style="@style/Input.AutoTapper.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/interval_label" app:helperText="@string/interval_help"><com.google.android.material.textfield.TextInputEditText android:id="@+id/et_interval_ms" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:maxLines="1" android:textColor="@color/text_primary" /></com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/Input.AutoTapper.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="@string/random_extra_label" app:helperText="@string/random_extra_help"><com.google.android.material.textfield.TextInputEditText android:id="@+id/et_random_extra_ms" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:maxLines="1" android:textColor="@color/text_primary" /></com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/Input.AutoTapper.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="@string/repeat_count_label" app:helperText="@string/repeat_count_help"><com.google.android.material.textfield.TextInputEditText android:id="@+id/et_repeat_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:maxLines="1" android:textColor="@color/text_primary" /></com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/Input.AutoTapper.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="@string/default_hold_label" app:helperText="@string/default_hold_help"><com.google.android.material.textfield.TextInputEditText android:id="@+id/et_default_hold_ms" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:maxLines="1" android:textColor="@color/text_primary" /></com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/Input.AutoTapper.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="@string/default_point_repeat_label" app:helperText="@string/default_point_repeat_help"><com.google.android.material.textfield.TextInputEditText android:id="@+id/et_default_point_repeat" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:maxLines="1" android:textColor="@color/text_primary" /></com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_apply_point_defaults" style="@style/Button.AutoTapper.Outlined" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp" android:text="@string/apply_point_defaults" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/config_summary_title" android:textAppearance="@style/Text.AutoTapper.Eyebrow" />
                <TextView android:id="@+id/tv_config_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_summary" android:lineSpacingExtra="4dp" android:padding="16dp" android:textAppearance="@style/Text.AutoTapper.Body" android:textColor="@color/on_accent_container" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        style="@style/Card.AutoTapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:id="@+id/btn_toggle_profiles" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:minHeight="64dp" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="10dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/profiles_title" android:textAppearance="@style/Text.AutoTapper.Title" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="1" android:ellipsize="end" android:text="@string/profiles_subtitle" android:textAppearance="@style/Text.AutoTapper.Caption" />
                </LinearLayout>
                <ImageView android:id="@+id/arrow_profiles" android:layout_width="40dp" android:layout_height="40dp" android:contentDescription="@null" android:padding="8dp" android:src="@drawable/ic_expand_more" app:tint="@color/text_secondary" />
            </LinearLayout>
            <LinearLayout android:id="@+id/group_profiles_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="16dp" android:visibility="gone">
                <TextView android:id="@+id/tv_profiles_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_status_row" android:gravity="center" android:minHeight="64dp" android:padding="14dp" android:text="@string/profile_list_empty" android:textAppearance="@style/Text.AutoTapper.Body" />
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_profiles" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView style="@style/Card.AutoTapper.Filled" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/usage_title" android:textAppearance="@style/Text.AutoTapper.Eyebrow" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:lineSpacingExtra="4dp" android:text="@string/usage_note" android:textAppearance="@style/Text.AutoTapper.Body" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
