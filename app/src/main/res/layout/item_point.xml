<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_point_item"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="4dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/tv_point_index"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/Text.AutoTapper.Body"
        android:textColor="?attr/colorPrimary"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_point_coords"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:textAppearance="@style/Text.AutoTapper.Body" />

    <ImageView
        android:id="@+id/btn_point_delete"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_circular_button"
        android:contentDescription="@string/delete_point_desc"
        android:padding="10dp"
        android:src="@drawable/ic_overlay_delete"
        app:tint="?attr/colorOnSurface" />

</LinearLayout>
